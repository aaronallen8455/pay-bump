cabal-version:      3.0
name:               pay-bump-generics
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Aaron Allen
maintainer:         aaronallen8455@gmail.com
-- copyright:
category:           Network
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  Payload.Extend.Generics
    -- other-modules:
    -- other-extensions:
    build-depends:    base,
                      pay-bump
    hs-source-dirs:   src
    default-language: GHC2021

test-suite pay-bump-generics-test
    import:           warnings
    default-language: GHC2021
    -- other-modules:
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base,
        pay-bump-generics,
        tasty,
        tasty-hunit
