cabal-version:      3.0
name:               pay-bump
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Aaron Allen
maintainer:         aaronallen8455@gmail.com
-- copyright:
category:           Network
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  Payload.Extend
    -- other-modules:
    -- other-extensions:
    build-depends:    base,
                      aeson,
                      openapi3 <= 3.2.5,
                      vector,
                      insert-ordered-containers,
                      containers,
                      transformers,
                      mtl,
                      text,
                      semialign
    hs-source-dirs:   src
    default-language: GHC2021

test-suite pay-bump-test
    import:           warnings
    default-language: GHC2021
    -- other-modules:
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base,
        pay-bump,
        openapi3,
        aeson,
        tasty,
        tasty-hunit
